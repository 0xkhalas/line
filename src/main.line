// ============================================================================
// STANDARD EXTERN
// ============================================================================

// Standard I/O functions
pub extern fun printf(format: *u8, params values: []any);
pub extern fun scanf(format: *u8, params values: []any);
pub extern fun fopen(path: *u8, mode: *u8) : *void;
pub extern fun fclose(file: *void);
pub extern fun fread(ptr: *void, size: u32, count: u32, file: *void) : u32;
pub extern fun fseek(file: *void, offset: i32, origin: i32) : i32;
pub extern fun ftell(file: *void) : i32;

// Memory management functions
pub extern fun malloc(size: u32) : *void;
pub extern fun calloc(count: u32, size: u32) : *void;
pub extern fun realloc(ptr: *void, size: u32) : *void;
pub extern fun free(ptr: *void);

// Memory functions
pub extern fun memcpy(dest: *void, src: *void, n: u32) : *void;
pub extern fun memmove(dest: *void, src: *void, n: u32) : *void;
pub extern fun memset(ptr: *void, value: i32, n: u32) : *void;
pub extern fun memcmp(ptr1: *void, ptr2: *void, n: u32) : i32;

// String functions
pub extern fun strlen(str: *u8) : u32;
pub extern fun strcpy(dest: *u8, src: *u8) : *u8;
pub extern fun strcmp(str1: *u8, str2: *u8) : i32;
pub extern fun strcat(dest: *u8, src: *u8) : *u8;
pub extern fun strncpy(dest: *u8, src: *u8, n: u32) : *u8;

// System functions
pub extern fun exit(status: i32) : void;
pub extern fun getenv(name: *u8) : *u8;
pub extern fun system(command: *u8) : i32;

// ============================================================================
// MEMORY ALLOCATOR
// ============================================================================

const AllocNode = struct {
	addr: *void,
	size: u32,
	level: u32,
	next: *AllocNode,
}

const Allocator = struct {
	head: *AllocNode,
	count: u32,
	level: u32,
}

fun alloc_init() : Allocator {
	let allocator: Allocator = .{};
	allocator.head = 0 as *AllocNode;
	allocator.count = 0;
	return allocator;
}

fun alloc_new(allocator: *Allocator, size: u32) : *void {
	let ptr: *void = malloc(size);
	if ptr as i32 == 0 {
		return 0 as *void;
	}

	let node: *AllocNode = malloc(@sizeOf(AllocNode)) as *AllocNode;
	if node as i32 == 0 {
		free(ptr);
		return 0 as *void;
	}

	node.*.addr = ptr;
	node.*.size = size;
	node.*.level = allocator.*.level;
	node.*.next = allocator.*.head;

	allocator.*.head = node;
	allocator.*.count = allocator.*.count + 1;

	return ptr;
}

fun alloc_resize(allocator: *Allocator, ptr: *void, new_size: u32) : *void {
	if ptr as i32 == 0 {
		return alloc_new(allocator, new_size);
	}

	let current: *AllocNode = allocator.*.head;
	while current as i32 != 0 {
		if current.*.addr == ptr {
			let new_ptr: *void = realloc(ptr, new_size);
			if new_ptr as i32 == 0 {
				return 0 as *void;
			}

			current.*.addr = new_ptr;
			current.*.size = new_size;

			return new_ptr;
		}
		current = current.*.next;
	}

	return 0 as *void;
}

fun alloc_push_level(allocator: *Allocator) {
	allocator.*.level = allocator.*.level + 1;
}

fun alloc_pop_level(allocator: *Allocator) {
	let current: *AllocNode = allocator.*.head;
	let previous: *AllocNode = 0 as *AllocNode;

	while current as i32 != 0 {
		if current.*.level == allocator.*.level {
			if previous as i32 == 0 {
				allocator.*.head = current.*.next;
			} else {
				previous.*.next = current.*.next;
			}

			free(current.*.addr);
			free(current);
			allocator.*.count = allocator.*.count - 1;

			if previous as i32 == 0 {
				current = allocator.*.head;
			} else {
				current = previous.*.next;
			}
		} else {
			previous = current;
			current = current.*.next;
		}
	}

	if allocator.*.level > 0 {
		allocator.*.level = allocator.*.level - 1;
	}
}

fun alloc_delete(allocator: *Allocator, ptr: *void) : bool {
	if ptr as i32 == 0 {
		return false;
	}

	let current: *AllocNode = allocator.*.head;
	let previous: *AllocNode = 0 as *AllocNode;

	while current as i32 != 0 {
		if current.*.addr == ptr {
			if previous as i32 == 0 {
				allocator.*.head = current.*.next;
			} else {
				previous.*.next = current.*.next;
			}

			free(current.*.addr);
			free(current);
			allocator.*.count = allocator.*.count - 1;

			return true;
		}

		previous = current;
		current = current.*.next;
	}

	return false;
}

fun alloc_free(allocator: *Allocator) {
	let current: *AllocNode = allocator.*.head;

	while current as i32 != 0 {
		let next: *AllocNode = current.*.next;

		free(current.*.addr);

		free(current);

		current = next;
	}

	allocator.*.head = 0 as *AllocNode;
	allocator.*.count = 0;
	allocator.*.level = 0;
}

fun alloc_count(allocator: *Allocator) : u32 {
	return allocator.*.count;
}

fun alloc_debug(allocator: *Allocator) {
	printf("Allocator: %d level, %d blocks allocated\n", allocator.*.level, allocator.*.count);

	let current: *AllocNode = allocator.*.head;
	let index: i32 = 0;

	while current as i32 != 0 {
		printf("  [%d] addr=%p, level=%d, size=%d\n", index, current.*.addr, current.*.level, current.*.size);
		current = current.*.next;
		index = index + 1;
	}
}

// ============================================================================
// GENERIC DYNAMIC LIST (VECTOR)
// ============================================================================

const List = struct {
	data: **void,
	len: u32,
	cap: u32,
	allocator: *Allocator,
}

fun list_init(allocator: *Allocator) : List {
	let arr: List = .{};
	arr.data = alloc_new(allocator, @sizeOf(*void) * 8) as **void;
	arr.len = 0;
	arr.cap = 8;
	return arr;
}

fun list_push(arr: *List, value: *void) {
	if (arr.*.len >= arr.*.cap) {
		arr.*.cap = arr.*.cap * 2;
		arr.*.data = alloc_resize(arr.*.allocator, arr.*.data, arr.*.cap * @sizeOf(*void)) as **void;
	}

	arr.*.data[arr.*.len] = value;
	arr.*.len = arr.*.len + 1;
}

fun list_get(arr: *List, index: u32) : *void {
	if index >= arr.*.len {
		return 0 as *void;
	} else if index < 0 {
		return 0 as *void;
	}

	return arr.*.data[index];
}

fun list_set(arr: *List, index: u32, value: *void) {
	if index >= arr.*.len {
		return;
	} else if index < 0 {
		return;
	}

	arr.*.data[index] = value;
}

fun list_pop(arr: *List) : *void {
	if arr.*.len == 0 {
		return 0 as *void;
	}

	arr.*.len = arr.*.len - 1;
	return arr.*.data[arr.*.len];
}

fun list_size(arr: *List) : u32 {
	return arr.*.len;
}

fun list_free(arr: *List) {
	alloc_delete(arr.*.allocator, arr.*.data);
	arr.*.data = 0;
	arr.*.len = 0;
	arr.*.cap = 0;
}

// ============================================================================
// IO
// ============================================================================

fun read_file_all(path: *u8) : *u8 {
	let file: *void = fopen(path, "rb");
	if (file as i32 == 0) {
		printf("Failed to open file: %s\n", path);
		exit(1);
	}

	fseek(file, 0, 2);
	let size: i32 = ftell(file);
	fseek(file, 0, 0);

	let buf: *u8 = malloc(size + 1) as *u8;
	if (buf as i32 == 0) {
		printf("Failed to allocate memory for file\n");
		fclose(file);
		exit(1);
	}

	let read_size: i32 = fread(buf, 1, size, file);
	buf[read_size] = 0;
	fclose(file);
	return buf;
}

// ============================================================================
// LEXER
// ============================================================================

const SpanSource = struct {
	start: i32,
	end: i32,
}

const Location = struct {
	idx: i32,
	line: i32,
}

const TokenKind = enum {
	Identifier,
	Integer,
	Float,
	String,
	Char,
	Symbol,
	Keyword,
	EndOfFile,
}

const Token = struct {
	kind: TokenKind,
	span: SpanSource,
	loc: Location,
}

const LexState = struct {
	src: *u8,
	src_len: i32,
	pos: i32,
	loc: Location,
}

fun is_letter(c: u8) : bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

fun is_digit(c: u8) : bool {
	return (c >= '0' && c <= '9');
}

fun is_keyword(str: *u8) : bool {
	if strcmp(str, "pub") == 0 { return true; }
	else if strcmp(str, "fun") == 0 { return true; }
	else if strcmp(str, "return") == 0 { return true; }
	else if strcmp(str, "let") == 0 { return true; }
	else if strcmp(str, "const") == 0 { return true; }
	else if strcmp(str, "if") == 0 { return true; }
	else if strcmp(str, "else") == 0 { return true; }
	else if strcmp(str, "while") == 0 { return true; }
	else if strcmp(str, "defer") == 0 { return true; }
	else if strcmp(str, "continue") == 0 { return true; }
	else if strcmp(str, "break") == 0 { return true; }
	else if strcmp(str, "void") == 0 { return true; }
	else if strcmp(str, "bool") == 0 { return true; }
	else if strcmp(str, "comp") == 0 { return true; }
	else if strcmp(str, "extern") == 0 { return true; }
	else if strcmp(str, "struct") == 0 { return true; }
	else if strcmp(str, "enum") == 0 { return true; }
	else if strcmp(str, "union") == 0 { return true; }
	else if strcmp(str, "true") == 0 { return true; }
	else if strcmp(str, "false") == 0 { return true; }
	else if strcmp(str, "any") == 0 { return true; }
	else if strcmp(str, "as") == 0 { return true; }
	else { return false; }
}

fun lex_init(src: *u8) : LexState {
	let state: LexState = .{};
	state.src = src;
	state.src_len = strlen(src) as i32;
	state.pos = 0;
	state.loc = .{ .index = 0, .line = 1};
	return state;
}

fun lex_init_span_source(start: i32, end: i32) : SpanSource {
	let s: SpanSource = .{};
	s.start = start;
	s.end = end;
	return s;
}

fun lex_eof(state: *LexState) : bool {
	return state.*.pos >= state.*.src_len;
}

fun lex_init_token(state: *LexState, kind: TokenKind, start: i32, end: i32) : Token {
	let t: Token = .{};
	t.kind = kind;
	t.span = lex_init_span_source(start, end);
	t.loc = state.*.loc;
	return t;
}

fun lex_span_source(state: *LexState, src: SpanSource, handle_escapes: bool) : *u8 {
	let len: i32 = src.end - src.start;
	let text: *u8 = malloc(len + 1) as *u8;

	if handle_escapes {
		let read_pos: i32 = 0;
		let write_pos: i32 = 0;

		while read_pos < len {
			let c: u8 = state.*.src[src.start + read_pos];

			if c == '\\' && (read_pos + 1) < len {
				read_pos = read_pos + 1;
				let escape_char: u8 = state.*.src[src.start + read_pos];

				if escape_char == 'n' {
					text[write_pos] = '\n';
				} else if escape_char == 't' {
					text[write_pos] = '\t';
				} else if escape_char == 'r' {
					text[write_pos] = '\r';
				} else if escape_char == '\\' {
					text[write_pos] = '\\';
				} else if escape_char == '\'' {
					text[write_pos] = '\'';
				} else if escape_char == '"' {
					text[write_pos] = '"';
				} else if escape_char == '0' {
					text[write_pos] = '\0';
				} else {
					text[write_pos] = escape_char;
				}
			} else {
				text[write_pos] = c;
			}

			read_pos = read_pos + 1;
			write_pos = write_pos + 1;
		}

		text[write_pos] = 0; // null-terminate
	} else {
		strncpy(text, state.*.src + src.start, len as u32);
		text[len] = 0; // null-terminate
	}

	return text;
}

fun lex_char(state: *LexState) : u8 {
	if lex_eof(state) {
		return '\0';
	}

	return state.*.src[state.*.pos];
}

fun lex_skip_whitespace(src: *u8, i: *i32) {
	while (src[i.*] == ' ' || src[i.*] == '\t' || src[i.*] == '\n' || src[i.*] == '\r') {
		let index: i32 = i.*;

		index = index + 1;
		i.* = index;
	}
}

fun lex_next_char(state: *LexState) : u8 {
	if lex_eof(state) {
		return '\0';
	}

	let c: u8 = state.*.src[state.*.pos];
	state.*.pos = state.*.pos + 1;

	return c;
}

fun lex_peek_char(state: *LexState, index: i32) : u8 {
	if lex_eof(state) {
		return '\0';
	}

	if (state.*.pos + index) >= state.*.src_len {
		return '\0';
	}

	return state.*.src[state.*.pos + index];
}

fun lex_number(state: *LexState) : Token {
	let start_pos: i32 = state.*.pos;
	let is_float: bool = false;

	while !lex_eof(state) && is_digit(lex_char(state)) || (lex_char(state) == '.' && !is_float) {
		if lex_char(state) == '.' {
			is_float = true;

			if lex_peek_char(state, 1) == '.' {
				break;
			}
		}

		state.*.pos = state.*.pos + 1;
	}

	return lex_init_token(state, if is_float { TokenKind.Float } else { TokenKind.Integer }, start_pos, state.*.pos);
}

fun lex_string(state: *LexState) : Token {
	lex_next_char(state);
	let start_pos: i32 = state.*.pos;

	while !lex_eof(state) {
		let c: u8 = lex_char(state);

		if c == '"' {
			break;
		} else if c == '\\' {
			state.*.pos = state.*.pos + 1;

			if !lex_eof(state) {
				state.*.pos = state.*.pos + 1;
			}
		} else {
			state.*.pos = state.*.pos + 1;
		}
	}

	let end_pos: i32 = state.*.pos;
	lex_next_char(state);

	return lex_init_token(state, TokenKind.String, start_pos, end_pos);
}

fun lex_character(state: *LexState) : Token {
	lex_next_char(state);
	let start_pos: i32 = state.*.pos;

	if !lex_eof(state) {
		let c: u8 = lex_char(state);

		if c == '\\' {
			state.*.pos = state.*.pos + 1;

			if !lex_eof(state) {
				state.*.pos = state.*.pos + 1;
			}
		} else {
			state.*.pos = state.*.pos + 1;
		}
	}

	let end_pos: i32 = state.*.pos;
	lex_next_char(state);

	return lex_init_token(state, TokenKind.Char, start_pos, end_pos);
}

fun lex_identifier(state: *LexState) : Token {
	let start_pos: i32 = state.*.pos;

	while !lex_eof(state) && is_letter(lex_char(state)) || is_digit(lex_char(state)) || lex_char(state) == '_' {
		state.*.pos = state.*.pos + 1;
	}

	let span: SpanSource = lex_init_span_source(start_pos, state.*.pos);
	let ident_str: *u8 = lex_span_source(state, span, false);
	defer free(ident_str);

	if is_keyword(ident_str) {
		return lex_init_token(state, TokenKind.Keyword, start_pos, state.*.pos);
	}

	return lex_init_token(state, TokenKind.Identifier, start_pos, state.*.pos);
}

fun lex_symbol(state: *LexState) : Token {
	let start_pos: i32 = state.*.pos;
	state.*.pos = state.*.pos + 1;

	return lex_init_token(state, TokenKind.Symbol, start_pos, state.*.pos);
}

fun lex_next(state: *LexState) : Token {
	if lex_eof(state) {
		return lex_init_token(state, TokenKind.EndOfFile, 0, 0);
	}

	while !lex_eof(state) {
		let c: u8 = lex_char(state);

		if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
			lex_next_char(state);
			continue;
		}

		if c == '/' && lex_peek_char(state, 1) == '/' {
			while !lex_eof(state) && lex_char(state) != '\n' {
				lex_next_char(state);
			}
			continue;
		}

		if c == '"' {
			return lex_string(state);
		}

		if c == '\'' {
			return lex_character(state);
		}

		if is_letter(c) {
			return lex_identifier(state);
		}

		if is_digit(c) {
			return lex_number(state);
		}

		return lex_symbol(state);
	}

	return lex_init_token(state, TokenKind.EndOfFile, 0, 0);
}

fun lex_peek(state: *LexState, index: i32) : Token {
	let token: Token = .{};

	let saved_pos: i32 = state.*.pos;

	while index >= 0 {
		token = lex_next(state);
		index = index - 1;
	}

	state.*.pos = saved_pos;

	return token;
}

fun lex_string_cmp(state: *LexState, str: *u8) : bool {
	let token: Token = lex_peek(state, 0);
	let span_str: *u8 = lex_span_source(state, token.span, false);
	let result: bool = strcmp(span_str, str) == 0;
	defer free(span_str);

	return result;
}

fun lex_char_cmp(state: *LexState, char: u8) : bool {
	let token: Token = lex_peek(state, 0);
	let span_str: *u8 = lex_span_source(state, token.span, false);
	let result: bool = span_str[0] == char && span_str[1] == 0;
	defer free(span_str);

	return result;
}

fun lex_kind_cmp(state: *LexState, kind: TokenKind) : bool {
	let token: Token = lex_peek(state, 0);
	return token.kind == kind;
}

fun lex_token_cmp(state: *LexState, kind: TokenKind, str: *u8) : bool {
	let token: Token = lex_peek(state, 0);
	if token.kind != kind {
		return false;
	}

	let span_str: *u8 = lex_span_source(state, token.span, false);
	let result: bool = strcmp(span_str, str) == 0;
	defer free(span_str);

	return result;
}

// ============================================================================
// LEXER PRINTING (Debug)
// ============================================================================

fun lex_print_token(state: *LexState, token: *Token) {
	let token_str: *u8 = lex_span_source(state, token.*.span, false);
	defer free(token_str);

	printf("Token: kind=%s, text='%s', span=[%d-%d], loc=(%d,%d)\n", @enumStr(TokenKind, token.*.kind), token_str, token.*.span.start, token.*.span.end, token.*.loc.idx, token.*.loc.line);
}

// ============================================================================
// AST
// ============================================================================

const ASTNodeKind = enum {
	Struct,
	Enum,
	Enumerator,
	Member,
	Let,
	Const,
	Function,
	Block,
	Break,
	Continue,
	Return,
	Defer,
	Type,
	Anonymous,
	Literal,
	Composite,
	Binary,
	Unary,
	Access,
	FunctionCall,
	BuiltinCall,
	If,
	While,
	Assignment,
	Cast,
}

const ASTNode = struct {
	kind: ASTNodeKind,
	span: SpanSource,
	data: *u8,
	children: List,
}

const TypeKind = enum {
	None,
	Integer,
	Float,
	Double,
	Boolean,
	Void,
	Any,
	Pointer,
	Array,
	Named,
	Struct,
	Enum,
}

const Type = struct {
	kind: TypeKind,
	data: *u8,
}

const TypeInteger = struct {
	bits: i32,
	is_signed: bool,
}

const TypeArray = struct {
	base: Type,
	size: i32,
}

const FunctionParam = struct {
	name: SpanSource,
	param_type: Type,
	is_comptime: bool,
	is_variadic: bool,
}

const FunctionData = struct {
	name: SpanSource,
	return_type: Type,
	params: List,
	is_public: bool,
	is_external: bool,
	is_declaration: bool,
}

const Operator = enum {
	None,
	Add,
	Sub,
	Mul,
	Div,
	Mod,
	And,
	Or,
	Xor,
	Eq,
	NotEq,
	Less,
	LessEq,
	Greater,
	GreaterEq,
	Shl,
	Shr,
	Not,
	Assign,
	Cast,
}

const BinaryProirity = struct {
	operator: Operator,
	priority: i32,
}

const LiteralKind = enum {
	Integer,
	Float,
	Double,
	Boolean,
	String,
	Char,
}

const LiteralData = struct {
	typ: LiteralKind,
	value: *u8,
}

const AccessStepKind = enum {
	Field,
	Index,
	Deref,
}

const AccessStep = struct {
	kind: AccessStepKind,
	data: *u8,
	span: SpanSource,
}

const AccessData = struct {
	root: SpanSource,
	steps: List,
}

const VariableData = struct {
	name: SpanSource,
	is_public: bool,
	is_const: bool,
}

const MemberData = struct {
	name: SpanSource,
	is_public: bool,
}

const IfData = struct {
	has_else: bool,
}

const CompositeFieldKind = enum {
	Named,
	Indexed,
}

const CompositeField = struct {
	kind: CompositeFieldKind,
	name: SpanSource,
	value: *ASTNode,
}

const CompositeData = struct {
	ty: Type,
	fields: List,
}

const BuiltinCallData = struct {
	name: SpanSource,
}

// ============================================================================
// AST HELPERS FUNCTIONS
// ============================================================================

fun ast_create_node(allocator: *Allocator, kind: ASTNodeKind, span: SpanSource) : *ASTNode {
	let node: *ASTNode = alloc_new(allocator, @sizeOf(ASTNode)) as *ASTNode;
	node.*.kind = kind;
	node.*.data = 0 as *u8;
	node.*.children = list_init(allocator);
	node.*.span = span;
	return node;
}

fun ast_add_child(parent: *ASTNode, child: *ASTNode) {
	list_push(&parent.*.children, child as *void);
}

fun ast_set_function_data(allocator: *Allocator, node: *ASTNode, name: SpanSource, return_type: Type, function_params: List, body: *ASTNode, is_public: bool, is_external: bool, is_declaration: bool) {
	let data: *FunctionData = alloc_new(allocator, @sizeOf(FunctionData)) as *FunctionData;
	data.*.name = name;
	data.*.return_type = return_type;
	data.*.params = function_params;
	data.*.is_external = is_external;
	data.*.is_declaration = is_declaration;
	data.*.is_public = is_public;

	if body as i32 != 0 {
		ast_add_child(node, body);
	}

	node.*.data = data as *u8;
}

fun ast_set_binary_op_data(node: *ASTNode, operator: Operator) {
	node.*.data = operator as *u8;
}

fun ast_set_unary_op_data(node: *ASTNode, operator: Operator) {
	node.*.data = operator as *u8;
}

fun ast_set_literal_data(allocator: *Allocator, node: *ASTNode, kind: LiteralKind, value: *u8) {
	let data: *LiteralData = alloc_new(allocator, @sizeOf(LiteralData)) as *LiteralData;
	data.*.typ = kind;
	data.*.value = value;
	node.*.data = data as *u8;
}

fun ast_create_access_step(allocator: *Allocator, kind: AccessStepKind, data: *u8, span: SpanSource) : *AccessStep {
	let step: *AccessStep = alloc_new(allocator, @sizeOf(AccessStep)) as *AccessStep;
	step.*.kind = kind;
	step.*.data = data;
	step.*.span = span;
	return step;
}

fun ast_set_access_data(allocator: *Allocator, node: *ASTNode, root: SpanSource, steps: List) {
	let data: *AccessData = alloc_new(allocator, @sizeOf(AccessData)) as *AccessData;
	data.*.root = root;
	data.*.steps = steps;
	node.*.data = data as *u8;
}

fun ast_set_variable_data(allocator: *Allocator, node: *ASTNode, name: SpanSource, is_const: bool, is_public: bool) {
	let data: *VariableData = alloc_new(allocator, @sizeOf(VariableData)) as *VariableData;
	data.*.name = name;
	data.*.is_const = is_const;
	data.*.is_public = is_public;
	node.*.data = data as *u8;
}

fun ast_set_member_data(allocator: *Allocator, node: *ASTNode, name: SpanSource, is_public: bool) {
	let data: *MemberData = alloc_new(allocator, @sizeOf(MemberData)) as *MemberData;
	data.*.name = name;
	data.*.is_public = is_public;
	node.*.data = data as *u8;
}

fun ast_set_enumerator_data(allocator: *Allocator, node: *ASTNode, name: SpanSource) {
	let data: *MemberData = alloc_new(allocator, @sizeOf(MemberData)) as *MemberData;
	data.*.name = name;
	data.*.is_public = true;
	node.*.data = data as *u8;
}

fun ast_set_if_data(allocator: *Allocator, node: *ASTNode, has_else: bool) {
	let data: *IfData = alloc_new(allocator, @sizeOf(IfData)) as *IfData;
	data.*.has_else = has_else;
	node.*.data = data as *u8;
}

fun ast_create_composite_field(allocator: *Allocator, kind: CompositeFieldKind, name: SpanSource, value: *ASTNode) : *CompositeField {
	let field: *CompositeField = alloc_new(allocator, @sizeOf(CompositeField)) as *CompositeField;
	field.*.kind = kind;
	field.*.name = name;
	field.*.value = value;
	return field;
}

fun ast_set_composite_data(allocator: *Allocator, node: *ASTNode, ty: Type, fields: List) {
	let data: *CompositeData = alloc_new(allocator, @sizeOf(CompositeData)) as *CompositeData;
	data.*.ty = ty;
	data.*.fields = fields;
	node.*.data = data as *u8;
}

fun ast_set_builtin_call_data(allocator: *Allocator, node: *ASTNode, name: SpanSource) {
	let data: *BuiltinCallData = alloc_new(allocator, @sizeOf(BuiltinCallData)) as *BuiltinCallData;
	data.*.name = name;
	node.*.data = data as *u8;
}

// ============================================================================
// AST PRINTING (Debug)
// ============================================================================

fun add_indent(indent: i32) {
	let i: i32 = 0;
	while i < indent {
		printf("  ");
		i = i + 1;
	}
}

fun ast_print_node(lexer: *LexState, node: *ASTNode, indent: i32);

fun ast_print_type(lexer: *LexState, typ: *Type, indent: i32) {
	if typ as i32 == 0 {
		printf("Type: <null>\n");
		return;
	}

	add_indent(indent);

	if typ.*.kind == TypeKind.Integer {
		let int_data: *TypeInteger = typ.*.data as *TypeInteger;
		printf("Type: Integer (bits: %d, signed: %d)\n", int_data.*.bits, int_data.*.is_signed);
	}
	else if typ.*.kind == TypeKind.Pointer {
		printf("Type: Pointer to:\n");
		let base: *Type = typ.*.data as *Type;
		ast_print_type(lexer, base, indent + 1);
	}
	else if typ.*.kind == TypeKind.Array {
		let arr: *TypeArray = typ.*.data as *TypeArray;
		printf("Type: Array (size: %d) of:\n", arr.*.size);
		ast_print_type(lexer, &arr.*.base, indent + 1);
	}
	else if typ.*.kind == TypeKind.Named {
		printf("Type: Named (%s)\n", typ.*.data);
	}
	else if typ.*.kind == TypeKind.Struct {
		printf("Type: Struct:\n");
		ast_print_node(lexer, typ.*.data as *ASTNode, indent + 1);
	}
	else if typ.*.kind == TypeKind.Enum {
		printf("Type: Enum:\n");
		ast_print_node(lexer, typ.*.data as *ASTNode, indent + 1);
	}
	else {
		printf("Type: %s\n", @enumStr(TypeKind, typ.*.kind));
	}
}

fun ast_print_node(lexer: *LexState, node: *ASTNode, indent: i32) {
	if node as i32 == 0 {
		return;
	}

	add_indent(indent);

	if node.*.kind == ASTNodeKind.Struct {
		printf("ASTNode: Struct\n");

		let j: i32 = 0;
		while j < list_size(&node.*.children) as i32 {
			let child: *ASTNode = list_get(&node.*.children, j) as *ASTNode;

			ast_print_node(lexer, child, indent + 1);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.Enum {
		printf("ASTNode: Enum\n");

		let j: i32 = 0;
		while j < list_size(&node.*.children) as i32 {
			let child: *ASTNode = list_get(&node.*.children, j) as *ASTNode;
			ast_print_node(lexer, child, indent + 1);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.Function {
		let data: *FunctionData = node.*.data as *FunctionData;
		printf("ASTNode: Function\n");

		if data as i32 == 0 {
			add_indent(indent + 1);
			printf("<null function data>\n");
			return;
		}

		let name_str: *u8 = lex_span_source(lexer, data.*.name, false);
		add_indent(indent + 1);
		printf("Name: %s\n", name_str);
		free(name_str);

		let pub_str: *u8 = if data.*.is_public { "public" } else { "private" };
		add_indent(indent + 1);
		printf("Visibility: %s\n", pub_str);

		let ext_str: *u8 = if data.*.is_external { "external" } else { "internal" };
		add_indent(indent + 1);
		printf("Linkage: %s\n", ext_str);

		let decl_str: *u8 = if data.*.is_declaration { "declaration" } else { "definition" };
		add_indent(indent + 1);
		printf("Type: %s\n", decl_str);

		add_indent(indent + 1);
		if list_size(&data.*.params) == 0 {
			printf("Params: <none>\n");
		} else {
			printf("Params:\n");
		}

		let k: i32 = 0;
		while k < list_size(&data.*.params) as i32 {
			let param: *FunctionParam = list_get(&data.*.params, k) as *FunctionParam;

			let param_name_str: *u8 = lex_span_source(lexer, param.*.name, false);
			add_indent(indent + 2);
			printf("Param %s, comptime: %d, variadic: %d\n", param_name_str, param.*.is_comptime, param.*.is_variadic);
			free(param_name_str);

			ast_print_type(lexer, &param.*.param_type, indent + 3);
			k = k + 1;
		}

		add_indent(indent + 1);
		printf("Return Type:\n");

		ast_print_type(lexer, &data.*.return_type, indent + 2);

		add_indent(indent + 1);
		if list_size(&node.*.children) == 0 {
			printf("Children: <none>\n");
		} else {
			printf("Children:\n");
		}

		let j: i32 = 0;
		while j < list_size(&node.*.children) as i32 {
			let child: *ASTNode = list_get(&node.*.children, j) as *ASTNode;
			ast_print_node(lexer, child, indent + 2);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.Block {
		printf("ASTNode: Block\n");

		let j: i32 = 0;
		while j < list_size(&node.*.children) as i32 {
			let child: *ASTNode = list_get(&node.*.children, j) as *ASTNode;
			ast_print_node(lexer, child, indent + 1);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.Break {
		printf("ASTNode: Break\n");

		let j: i32 = 0;
		while j < list_size(&node.*.children) as i32 {
			let child: *ASTNode = list_get(&node.*.children, j) as *ASTNode;
			ast_print_node(lexer, child, indent + 1);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.Continue {
		printf("ASTNode: Continue\n");
	}
	else if node.*.kind == ASTNodeKind.Return {
		printf("ASTNode: Return\n");

		let j: i32 = 0;
		while j < list_size(&node.*.children) as i32 {
			let child: *ASTNode = list_get(&node.*.children, j) as *ASTNode;
			ast_print_node(lexer, child, indent + 1);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.Defer {
		printf("ASTNode: Defer\n");

		let j: i32 = 0;
		while j < list_size(&node.*.children) as i32 {
			let child: *ASTNode = list_get(&node.*.children, j) as *ASTNode;
			ast_print_node(lexer, child, indent + 1);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.Let || node.*.kind == ASTNodeKind.Const {
		let is_const: bool = node.*.kind == ASTNodeKind.Const;
		let data: *VariableData = node.*.data as *VariableData;

		if data as i32 == 0 {
			printf("ASTNode: %s <no data>\n", if is_const { "Const" } else { "Let" });
		} else {
			let visibility: *u8 = if data.*.is_public { "public" } else { "private" };
			let var_name_str: *u8 = lex_span_source(lexer, data.*.name, false);
			printf("ASTNode: %s %s '%s'\n", visibility, if is_const { "Const" } else { "Let" }, var_name_str);
			free(var_name_str);
		}

		let j: i32 = 0;
		while j < list_size(&node.*.children) as i32 {
			let child: *ASTNode = list_get(&node.*.children, j) as *ASTNode;
			ast_print_node(lexer, child, indent + 1);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.Enumerator {
		let data: *MemberData = node.*.data as *MemberData;

		if data as i32 == 0 {
			printf("ASTNode: Enumerator <no data>\n");
		} else {
			let member_name_str: *u8 = lex_span_source(lexer, data.*.name, false);
			printf("ASTNode: Enumerator '%s'\n", member_name_str);
			free(member_name_str);
		}

		let j: i32 = 0;
		while j < list_size(&node.*.children) as i32 {
			let child: *ASTNode = list_get(&node.*.children, j) as *ASTNode;
			ast_print_node(lexer, child, indent + 1);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.Member {
		let data: *MemberData = node.*.data as *MemberData;

		if data as i32 == 0 {
			printf("ASTNode: Member <no data>\n");
		} else {
			let visibility: *u8 = if data.*.is_public { "public" } else { "private" };
			let member_name_str: *u8 = lex_span_source(lexer, data.*.name, false);
			printf("ASTNode: %s Member '%s'\n", visibility, member_name_str);
			free(member_name_str);
		}

		let j: i32 = 0;
		while j < list_size(&node.*.children) as i32 {
			let child: *ASTNode = list_get(&node.*.children, j) as *ASTNode;
			ast_print_node(lexer, child, indent + 1);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.Type {
		let typ: *Type = node.*.data as *Type;
		printf("ASTNode: Type\n");
		ast_print_type(lexer, typ, indent + 1);
	}
	else if node.*.kind == ASTNodeKind.Literal {
		let data: *LiteralData = node.*.data as *LiteralData;
		if data as i32 == 0 {
			add_indent(indent);
			printf("<null literal data>\n");
			return;
		}

		printf("Literal %s Value: '%s'\n", @enumStr(LiteralKind, data.*.typ), data.*.value);
	}
	else if node.*.kind == ASTNodeKind.Binary {
		let op: Operator = node.*.data as Operator;
		printf("ASTNode: Binary Operation (%s)\n", @enumStr(Operator, op));

		let j: i32 = 0;
		while j < list_size(&node.*.children) as i32 {
			let child: *ASTNode = list_get(&node.*.children, j) as *ASTNode;
			ast_print_node(lexer, child, indent + 1);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.Unary {
		let op: Operator = node.*.data as Operator;
		printf("ASTNode: Unary Operation (%s)\n", @enumStr(Operator, op));

		let j: i32 = 0;
		while j < list_size(&node.*.children) as i32 {
			let child: *ASTNode = list_get(&node.*.children, j) as *ASTNode;
			ast_print_node(lexer, child, indent + 1);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.Access {
		let data: *AccessData = node.*.data as *AccessData;
		if data as i32 == 0 {
			add_indent(indent);
			printf("<null access data>\n");
			return;
		}

		let access_root_str: *u8 = lex_span_source(lexer, data.*.root, false);
		printf("ASTNode: Access '%s'\n", access_root_str);
		free(access_root_str);

		add_indent(indent + 1);
		if list_size(&data.*.steps) == 0 {
			printf("Steps: <none>\n");
		} else {
			printf("Steps:\n");
		}

		let j: i32 = 0;
		while j < list_size(&data.*.steps) as i32 {
			let step: *AccessStep = list_get(&data.*.steps, j) as *AccessStep;
			add_indent(indent + 2);

			if step.*.kind == AccessStepKind.Field {
				let field_name_str: *u8 = lex_span_source(lexer, step.*.span, false);
				printf("Field '%s'\n", field_name_str);
				free(field_name_str);
			}
			else if step.*.kind == AccessStepKind.Deref {
				printf("Dereference\n");
			}
			else if step.*.kind == AccessStepKind.Index {
				printf("Index:\n");
				let index_ptr: *i32 = step.*.data as *i32;
				let child_index: i32 = index_ptr.*;
				let index_expr: *ASTNode = list_get(&node.*.children, child_index) as *ASTNode;
				ast_print_node(lexer, index_expr, indent + 3);
			}
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.FunctionCall {
		printf("ASTNode: Function Call\n");

		add_indent(indent + 1);
		printf("Function:\n");
		let func_expr: *ASTNode = list_get(&node.*.children, 0) as *ASTNode;
		ast_print_node(lexer, func_expr, indent + 2);

		add_indent(indent + 1);
		let argument_count: i32 = list_size(&node.*.children) - 1;
		if argument_count == 0 {
			printf("Arguments: <none>\n");
		} else {
			printf("Arguments (%d):\n", argument_count);
		}

		let j: i32 = 1;
		while j < list_size(&node.*.children) as i32 {
			let arg: *ASTNode = list_get(&node.*.children, j) as *ASTNode;
			ast_print_node(lexer, arg, indent + 2);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.BuiltinCall {
		let data: *BuiltinCallData = node.*.data as *BuiltinCallData;
		if data as i32 == 0 {
			add_indent(indent);
			printf("<null access data>\n");
			return;
		}

		printf("ASTNode: Builtin Call\n");

		let func_name_str: *u8 = lex_span_source(lexer, data.*.name, false);
		add_indent(indent + 1);
		printf("Function: '%s'\n", func_name_str);
		free(func_name_str);

		add_indent(indent + 1);
		let argument_count: i32 = list_size(&node.*.children);
		if argument_count == 0 {
			printf("Arguments: <none>\n");
		} else {
			printf("Arguments (%d):\n", argument_count);
		}

		let j: i32 = 0;
		while j < list_size(&node.*.children) as i32 {
			let arg: *ASTNode = list_get(&node.*.children, j) as *ASTNode;
			ast_print_node(lexer, arg, indent + 2);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.If {
		let data: *IfData = node.*.data as *IfData;
		printf("ASTNode: If (has_else: %s)\n", if data.*.has_else { "true" } else { "false" });

		add_indent(indent + 1);
		printf("Condition:\n");
		let condition: *ASTNode = list_get(&node.*.children, 0) as *ASTNode;
		ast_print_node(lexer, condition, indent + 2);

		add_indent(indent + 1);
		printf("Then:\n");
		let then_stmt: *ASTNode = list_get(&node.*.children, 1) as *ASTNode;
		ast_print_node(lexer, then_stmt, indent + 2);

		if data.*.has_else {
			add_indent(indent + 1);
			printf("Else:\n");
			let else_stmt: *ASTNode = list_get(&node.*.children, 2) as *ASTNode;
			ast_print_node(lexer, else_stmt, indent + 2);
		}
	}
	else if node.*.kind == ASTNodeKind.While {
		printf("ASTNode: While\n");

		add_indent(indent + 1);
		printf("Condition:\n");
		let condition: *ASTNode = list_get(&node.*.children, 0) as *ASTNode;
		ast_print_node(lexer, condition, indent + 2);

		add_indent(indent + 1);
		printf("Body:\n");
		let body: *ASTNode = list_get(&node.*.children, 1) as *ASTNode;
		ast_print_node(lexer, body, indent + 2);
	}
	else if node.*.kind == ASTNodeKind.Assignment {
		printf("ASTNode: Assignment\n");

		add_indent(indent + 1);
		printf("Target:\n");
		let target: *ASTNode = list_get(&node.*.children, 0) as *ASTNode;
		ast_print_node(lexer, target, indent + 2);

		add_indent(indent + 1);
		printf("Value:\n");
		let value: *ASTNode = list_get(&node.*.children, 1) as *ASTNode;
		ast_print_node(lexer, value, indent + 2);
	}
	else if node.*.kind == ASTNodeKind.Composite {
		let data: *CompositeData = node.*.data as *CompositeData;
		if data as i32 == 0 {
			printf("ASTNode: Composite <no data>\n");
			return;
		}

		printf("ASTNode: Composite\n");
		add_indent(indent + 1);
		printf("Type:\n");
		ast_print_type(lexer, &data.*.ty, indent + 2);

		add_indent(indent + 1);
		let field_count: i32 = list_size(&data.*.fields);
		if field_count == 0 {
			printf("Fields: <none>\n");
		} else {
			printf("Fields: %d\n", field_count);
		}

		let j: i32 = 0;
		while j < field_count as i32 {
			let field: *CompositeField = list_get(&data.*.fields, j) as *CompositeField;
			add_indent(indent + 2);

			if field.*.kind == CompositeFieldKind.Named {
				let name_str: *u8 = lex_span_source(lexer, field.*.name, false);
				printf("Field '%s':\n", name_str);
				free(name_str);
			} else {
				printf("Field [%d]:\n", j);
			}

			if field.*.value as i32 != 0 {
				ast_print_node(lexer, field.*.value, indent + 3);
			}
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.Anonymous {
		printf("ASTNode: Anonymous\n");

		let j: i32 = 0;
		while j < list_size(&node.*.children) as i32 {
			let arg: *ASTNode = list_get(&node.*.children, j) as *ASTNode;
			ast_print_node(lexer, arg, indent + 2);
			j = j + 1;
		}
	}
	else if node.*.kind == ASTNodeKind.Cast {
		printf("ASTNode: Cast\n");

		add_indent(indent + 1);
		printf("Expression:\n");
		let expr: *ASTNode = list_get(&node.*.children, 0) as *ASTNode;
		ast_print_node(lexer, expr, indent + 2);

		add_indent(indent + 1);
		printf("Target Type:\n");
		let type_node: *ASTNode = list_get(&node.*.children, 1) as *ASTNode;
		ast_print_node(lexer, type_node, indent + 2);
	}
	else {
		printf("ASTNode: Unknown kind %d\n", node.*.kind as i32);
	}
}

// ============================================================================
// PARSER
// ============================================================================

const Parser = struct {
	lex: LexState,
	allocator: *Allocator,
}

fun parser_init(lex: LexState, allocator: *Allocator) : Parser {
	let parser: Parser = .{};
	parser.lex = lex;
	parser.allocator = allocator;
	return parser;
}

fun parse_advance(parser: *Parser) {
	lex_next(&parser.*.lex);
}

fun parse_expect(parser: *Parser, kind: TokenKind) : bool {
	let token: Token = lex_peek(&parser.*.lex, 0);
	if token.kind == kind {
		parse_advance(parser);
		return true;
	}

	return false;
}

fun parse_expect_keyword(parser: *Parser, keyword: *u8) : bool {
	let token: Token = lex_peek(&parser.*.lex, 0);
	let token_str: *u8 = lex_span_source(&parser.*.lex, token.span, false);
	defer free(token_str);

	if token.kind == TokenKind.Keyword && strcmp(token_str, keyword) == 0 {
		parse_advance(parser);
		return true;
	}

	return false;
}

fun parse_expect_symbol(parser: *Parser, symbol: *u8) : bool {
	let token: Token = lex_peek(&parser.*.lex, 0);
	let token_str: *u8 = lex_span_source(&parser.*.lex, token.span, false);
	defer free(token_str);

	if token.kind == TokenKind.Symbol && strcmp(token_str, symbol) == 0 {
		parse_advance(parser);
		return true;
	}

	return false;
}

// ============================================================================
// TYPE PARSING
// ============================================================================

fun parse_aggregate(parser: *Parser, kind: ASTNodeKind) : *ASTNode;

fun parse_type(parser: *Parser) : Type {
	let token: Token = lex_peek(&parser.*.lex, 0);
	let token_str: *u8 = lex_span_source(&parser.*.lex, token.span, false);
	defer free(token_str);

	let typ: Type = .{};

	if (token_str[0] == 'i' || token_str[0] == 'u') {
		let is_signed: bool = (token_str[0] == 'i');
		let idx: i32 = 1;
		let bits: i32 = 0;

		while is_digit(token_str[idx]) {
			bits = bits * 10 + (token_str[idx] - '0') as i32;
			idx = idx + 1;
		}

		if bits > 0 && token_str[idx] == 0 {
			typ.kind = TypeKind.Integer;
			typ.data = alloc_new(parser.*.allocator, @sizeOf(TypeInteger)) as *u8;
			let int_data: *TypeInteger = typ.data as *TypeInteger;
			int_data.*.bits = bits;
			int_data.*.is_signed = is_signed;
			parse_advance(parser);
			return typ;
		} else {
			typ.kind = TypeKind.Named;
			typ.data = strcpy(alloc_new(parser.*.allocator, strlen(token_str) + 1) as *u8, token_str) as *u8;
			parse_advance(parser);
			return typ;
		}
	} else if strcmp(token_str, "f32") == 0 {
		typ.kind = TypeKind.Float;
		parse_advance(parser);
		return typ;
	} else if strcmp(token_str, "f64") == 0 {
		typ.kind = TypeKind.Double;
		parse_advance(parser);
		return typ;
	} else if strcmp(token_str, "bool") == 0 {
		typ.kind = TypeKind.Boolean;
		parse_advance(parser);
		return typ;
	} else if strcmp(token_str, "void") == 0 {
		typ.kind = TypeKind.Void;
		parse_advance(parser);
		return typ;
	} else if strcmp(token_str, "any") == 0 {
		typ.kind = TypeKind.Any;
		parse_advance(parser);
		return typ;
	} else if strcmp(token_str, "struct") == 0 {
		typ.kind = TypeKind.Struct;
		typ.data = parse_aggregate(parser, ASTNodeKind.Struct) as *u8;
	} else if strcmp(token_str, "enum") == 0 {
		typ.kind = TypeKind.Enum;
		typ.data = parse_aggregate(parser, ASTNodeKind.Enum) as *u8;
	} else if strcmp(token_str, "*") == 0 {
		parse_advance(parser);
		typ.kind = TypeKind.Pointer;
		typ.data = alloc_new(parser.*.allocator, @sizeOf(Type)) as *u8;

		let inner_type: Type = parse_type(parser);
		memcpy(typ.data as *void, &inner_type, @sizeOf(Type));
	} else if strcmp(token_str, "[") == 0 {
		parse_advance(parser);
		typ.kind = TypeKind.Array;
		typ.data = alloc_new(parser.*.allocator, @sizeOf(TypeArray)) as *u8;

		let arr_data: *TypeArray = typ.data as *TypeArray;
		arr_data.*.size = -1;

		let next_token: Token = lex_peek(&parser.*.lex, 0);
		if next_token.kind == TokenKind.Integer {
			let size_str: *u8 = lex_span_source(&parser.*.lex, next_token.span, false);
			defer free(size_str);

			let size: i32 = 0;
			let i: i32 = 0;
			while size_str[i] != 0 {
				size = size * 10 + (size_str[i] - '0') as i32;
				i = i + 1;
			}
			arr_data.*.size = size;
			parse_advance(parser);
		}

		if !parse_expect_symbol(parser, "]") {
			printf("Error: Expected ']'\n");
			exit(1);
		}

		arr_data.*.base = parse_type(parser);
	} else if token.kind == TokenKind.Identifier {
		typ.kind = TypeKind.Named;
		typ.data = strcpy(alloc_new(parser.*.allocator, strlen(token_str) + 1) as *u8, token_str) as *u8;
		parse_advance(parser);
		return typ;
	}

	return typ;
}

// ============================================================================
// OPERATOR PARSING
// ============================================================================

fun parse_operator(parser: *Parser, consume: bool) : Operator {
	let first_token: Token = lex_peek(&parser.*.lex, 0);
	let first_str: *u8 = lex_span_source(&parser.*.lex, first_token.span, false);
	defer free(first_str);

	let second_token: Token = lex_peek(&parser.*.lex, 1);
	let second_str: *u8 = lex_span_source(&parser.*.lex, second_token.span, false);
	defer free(second_str);

	if parse_expect_keyword(parser, "as") {
		return Operator.Cast;
	}

	if second_token.kind == TokenKind.Symbol && first_token.kind == TokenKind.Symbol {
		if first_str[0] == '=' && second_str[0] == '=' {
			if consume {
				parse_advance(parser);
				parse_advance(parser);
			}
			return Operator.Eq;
		} else if first_str[0] == '!' && second_str[0] == '=' {
			if consume {
				parse_advance(parser);
				parse_advance(parser);
			}
			return Operator.NotEq;
		} else if first_str[0] == '<' && second_str[0] == '=' {
			if consume {
				parse_advance(parser);
				parse_advance(parser);
			}
			return Operator.LessEq;
		} else if first_str[0] == '>' && second_str[0] == '=' {
			if consume {
				parse_advance(parser);
				parse_advance(parser);
			}
			return Operator.GreaterEq;
		} else if first_str[0] == '<' && second_str[0] == '<' {
			if consume {
				parse_advance(parser);
				parse_advance(parser);
			}
			return Operator.Shl;
		} else if first_str[0] == '>' && second_str[0] == '>' {
			if consume {
				parse_advance(parser);
				parse_advance(parser);
			}
			return Operator.Shr;
		}
	}

	if first_token.kind == TokenKind.Symbol {
		if first_str[0] == '+' {
			if consume {
				parse_advance(parser);
			}
			return Operator.Add;
		} else if first_str[0] == '-' {
			if consume {
				parse_advance(parser);
			}
			return Operator.Sub;
		} else if first_str[0] == '*' {
			if consume {
				parse_advance(parser);
			}
			return Operator.Mul;
		} else if first_str[0] == '/' {
			if consume {
				parse_advance(parser);
			}
			return Operator.Div;
		} else if first_str[0] == '%' {
			if consume {
				parse_advance(parser);
			}
			return Operator.Mod;
		} else if first_str[0] == '&' {
			if consume {
				parse_advance(parser);
			}
			return Operator.And;
		} else if first_str[0] == '|' {
			if consume {
				parse_advance(parser);
			}
			return Operator.Or;
		} else if first_str[0] == '^' {
			if consume {
				parse_advance(parser);
			}
			return Operator.Xor;
		} else if first_str[0] == '<' {
			if consume {
				parse_advance(parser);
			}
			return Operator.Less;
		} else if first_str[0] == '>' {
			if consume {
				parse_advance(parser);
			}
			return Operator.Greater;
		} else if first_str[0] == '!' {
			if consume {
				parse_advance(parser);
			}
			return Operator.Not;
		} else if first_str[0] == '=' {
			if consume {
				parse_advance(parser);
			}
			return Operator.Assign;
		}
	}

	return Operator.None;
}

fun operator_cmp(parser: *Parser, operators: *Operator, count: i32) : bool {
	let oper: Operator = parse_operator(parser, false);
	let i: i32 = 0;

	while i < count {
		if oper == operators[i] {
			return true;
		}
		i = i + 1;
	}

	return false;
}

fun operator_precedence(oper: Operator) : i32 {
	if oper == Operator.Eq || oper == Operator.NotEq {
		return 30;
	}
	else if oper == Operator.Greater || oper == Operator.GreaterEq || oper == Operator.Less || oper == Operator.LessEq {
		return 35;
	}
	else if oper == Operator.Add || oper == Operator.Sub {
		return 45;
	}
	else if oper == Operator.Mul || oper == Operator.Div || oper == Operator.Mod {
		return 50;
	}
	else if oper == Operator.And {
		return 25;
	}
	else if oper == Operator.Or {
		return 15;
	}
	else if oper == Operator.Xor {
		return 20;
	}
	else if oper == Operator.Shl || oper == Operator.Shr {
		return 40;
	}
	else if oper == Operator.Not {
		return 60;
	}
	else if oper == Operator.Cast {
		return 70;
	}

	return -1;
}

fun parse_binary_proirity(parser: *Parser, consume: bool) : BinaryProirity {
	let oper: Operator = parse_operator(parser, consume);
	let priority: i32 = operator_precedence(oper);

	let bp: BinaryProirity = .{};
	bp.operator = oper;
	bp.priority = priority;
	return bp;
}

fun print_binary_proirity(bp: BinaryProirity) {
	printf("BinaryProirity: operator=%s, priority=%d\n", @enumStr(Operator, bp.operator), bp.priority);
}

// ============================================================================
// EXPRESSION PARSING
// ============================================================================

fun parse_expression(parser: *Parser, limit: i32) : *ASTNode;
fun parse_if(parser: *Parser) : *ASTNode;

fun parse_literal(parser: *Parser) : *ASTNode {
	let token: Token = lex_peek(&parser.*.lex, 0);
	let token_str: *u8 = lex_span_source(&parser.*.lex, token.span, false);
	defer free(token_str);

	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Literal, token.span);

	if token.kind == TokenKind.Integer {
		ast_set_literal_data(parser.*.allocator, node, LiteralKind.Integer, strcpy(alloc_new(parser.*.allocator, strlen(token_str) + 1) as *u8, token_str) as *u8);
		parse_advance(parser);
		return node;
	} else if token.kind == TokenKind.Float {
		ast_set_literal_data(parser.*.allocator, node, LiteralKind.Float, strcpy(alloc_new(parser.*.allocator, strlen(token_str) + 1) as *u8, token_str) as *u8);
		parse_advance(parser);
		return node;
	} else if token.kind == TokenKind.String {
		ast_set_literal_data(parser.*.allocator, node, LiteralKind.String, strcpy(alloc_new(parser.*.allocator, strlen(token_str) + 1) as *u8, token_str) as *u8);
		parse_advance(parser);
		return node;
	} else if token.kind == TokenKind.Char {
		ast_set_literal_data(parser.*.allocator, node, LiteralKind.Char, strcpy(alloc_new(parser.*.allocator, strlen(token_str) + 1) as *u8, token_str) as *u8);
		parse_advance(parser);
		return node;
	} else if token.kind == TokenKind.Keyword && strcmp(token_str, "true") == 0 {
		ast_set_literal_data(parser.*.allocator, node, LiteralKind.Boolean, strcpy(alloc_new(parser.*.allocator, 5) as *u8, "true") as *u8);
		parse_advance(parser);
		return node;
	} else if token.kind == TokenKind.Keyword && strcmp(token_str, "false") == 0 {
		ast_set_literal_data(parser.*.allocator, node, LiteralKind.Boolean, strcpy(alloc_new(parser.*.allocator, 6) as *u8, "false") as *u8);
		parse_advance(parser);
		return node;
	}

	return 0 as *ASTNode;
}

fun parse_access(parser: *Parser) : *ASTNode {
	let root_token: Token = lex_peek(&parser.*.lex, 0);

	if root_token.kind != TokenKind.Identifier {
		return 0 as *ASTNode;
	}

	let root_span: SpanSource = root_token.span;
	parse_advance(parser);

	let steps: List = list_init(parser.*.allocator);
	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Access, lex_init_span_source(root_span.start, parser.*.lex.pos));

	while true {
		let token: Token = lex_peek(&parser.*.lex, 0);

		if lex_char_cmp(&parser.*.lex, '.') {
			parse_advance(parser);

			let next_token: Token = lex_peek(&parser.*.lex, 0);

			if lex_char_cmp(&parser.*.lex, '*') {
				let deref_token: Token = lex_next(&parser.*.lex);
				let step: *AccessStep = ast_create_access_step(parser.*.allocator, AccessStepKind.Deref, 0 as *u8, deref_token.span);
				list_push(&steps, step as *void);
			} else if next_token.kind == TokenKind.Identifier {
				let field_token: Token = lex_next(&parser.*.lex);
				let step: *AccessStep = ast_create_access_step(parser.*.allocator, AccessStepKind.Field, 0 as *u8, field_token.span);
				list_push(&steps, step as *void);
			} else {
				break;
			}
		} else if lex_char_cmp(&parser.*.lex, '[') {
			let start_pos: i32 = parser.*.lex.pos;
			parse_advance(parser);

			let index_expr: *ASTNode = parse_expression(parser, 0);
			if index_expr as i32 == 0 {
				return 0 as *ASTNode;
			}

			if !parse_expect_symbol(parser, "]") {
				return 0 as *ASTNode;
			}

			ast_add_child(node, index_expr);

			let child_index: i32 = list_size(&node.*.children) - 1;
			let index_ptr: *i32 = alloc_new(parser.*.allocator, @sizeOf(i32)) as *i32;
			index_ptr.* = child_index;

			let index_span: SpanSource = lex_init_span_source(start_pos, parser.*.lex.pos);
			let step: *AccessStep = ast_create_access_step(parser.*.allocator, AccessStepKind.Index, index_ptr as *u8, index_span);
			list_push(&steps, step as *void);
		} else {
			break;
		}
	}

	node.*.span.end = parser.*.lex.pos;
	ast_set_access_data(parser.*.allocator, node, root_span, steps);

	return node;
}

fun parse_composite(parser: *Parser) : *ASTNode {
	let start_pos: i32 = parser.*.lex.pos;

	let ty: Type = parse_type(parser);

	if !parse_expect_symbol(parser, "{") {
		printf("Error: Expected '{' after type in composite literal\n");
		return 0 as *ASTNode;
	}

	let fields: List = list_init(parser.*.allocator);

	while !lex_char_cmp(&parser.*.lex, '}') {
		if lex_kind_cmp(&parser.*.lex, TokenKind.EndOfFile) {
			printf("Error: Unexpected end of file in composite literal\n");
			break;
		}

		let current_token: Token = lex_peek(&parser.*.lex, 0);

		if lex_char_cmp(&parser.*.lex, '}') {
			break;
		}

		let field_name: SpanSource = .{};
		let field_kind: CompositeFieldKind = CompositeFieldKind.Indexed;

		if lex_char_cmp(&parser.*.lex, '.') {
			parse_advance(parser);

			let name_token: Token = lex_peek(&parser.*.lex, 0);
			if name_token.kind != TokenKind.Identifier {
				printf("Error: Expected field name after '.' in composite literal\n");
				break;
			}

			field_name = name_token.span;
			field_kind = CompositeFieldKind.Named;
			parse_advance(parser);

			if !parse_expect_symbol(parser, "=") {
				printf("Error: Expected '=' after field name in composite literal\n");
				break;
			}
		}

		let value: *ASTNode = parse_expression(parser, 0);
		if value as i32 == 0 {
			printf("Error: Expected expression for field value in composite literal\n");
			break;
		}

		let field: *CompositeField = ast_create_composite_field(parser.*.allocator, field_kind, field_name, value);
		list_push(&fields, field as *void);

		if lex_char_cmp(&parser.*.lex, ',') {
			parse_advance(parser);
		} else if !lex_char_cmp(&parser.*.lex, '}') {
			printf("Error: Expected ',' or '}' in composite literal\n");
			break;
		}
	}

	if !parse_expect_symbol(parser, "}") {
		printf("Error: Expected '}' to close composite literal\n");
		return 0 as *ASTNode;
	}

	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Composite, lex_init_span_source(start_pos, parser.*.lex.pos));
	ast_set_composite_data(parser.*.allocator, node, ty, fields);

	let i: i32 = 0;
	while i < list_size(&fields) as i32 {
		let field: *CompositeField = list_get(&fields, i) as *CompositeField;
		if field.*.value as i32 != 0 {
			ast_add_child(node, field.*.value);
		}
		i = i + 1;
	}

	return node;
}

fun parse_anonymous(parser: *Parser) : *ASTNode {
	if !parse_expect_symbol(parser, ".") {
		return 0 as *ASTNode;
	}

	if lex_token_cmp(&parser.*.lex, TokenKind.Symbol, "{") {
		let composite_node: *ASTNode = parse_composite(parser);
		let anon_node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Anonymous, lex_init_span_source(composite_node.*.span.start - 1, composite_node.*.span.end));
		ast_add_child(anon_node, composite_node);
		return anon_node;
	}

	let expr: *ASTNode = parse_expression(parser, 0);
	if expr as i32 == 0 {
		return 0 as *ASTNode;
	}

	let anon_node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Anonymous, lex_init_span_source(expr.*.span.start - 1, expr.*.span.end));
	ast_add_child(anon_node, expr);

	return anon_node;
}

fun parse_function_call(parser: *Parser, func_expr: *ASTNode) : *ASTNode {
	let start_pos: i32 = func_expr.*.span.start;

	if !parse_expect_symbol(parser, "(") {
		return 0 as *ASTNode;
	}

	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.FunctionCall, lex_init_span_source(start_pos, parser.*.lex.pos));

	ast_add_child(node, func_expr);

	while !lex_token_cmp(&parser.*.lex, TokenKind.Symbol, ")") {
		if lex_kind_cmp(&parser.*.lex, TokenKind.EndOfFile) {
			break;
		}

		let arg: *ASTNode = parse_expression(parser, 0);
		if arg as i32 == 0 {
			return 0 as *ASTNode;
		}

		ast_add_child(node, arg);

		if lex_char_cmp(&parser.*.lex, ',') {
			parse_advance(parser);
		}
	}

	if !parse_expect_symbol(parser, ")") {
		let curr_token: Token = lex_peek(&parser.*.lex, 0);
		lex_print_token(&parser.*.lex, &curr_token);

		printf("Error: Expected ')' to close function call\n");
		exit(0);
	}

	node.*.span.end = parser.*.lex.pos;
	node.*.data = 0 as *u8;

	return node;
}

fun parse_builtin_call(parser: *Parser) : *ASTNode {
	let start_pos: i32 = parser.*.lex.pos;

	if !parse_expect_symbol(parser, "@") {
		printf("Error: Expected '@' for builtin function call\n");
		return 0 as *ASTNode;
	}

	let name_token: Token = lex_next(&parser.*.lex);
	if name_token.kind != TokenKind.Identifier {
		printf("Error: Expected identifier after '@' for builtin function call\n");
		exit(0);
	}

	if !parse_expect_symbol(parser, "(") {
		printf("Error: Expected '(' after '@' for builtin function call\n");
		return 0 as *ASTNode;
	}

	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.BuiltinCall, lex_init_span_source(start_pos, 0));

	while !lex_char_cmp(&parser.*.lex, ')') {
		if lex_kind_cmp(&parser.*.lex, TokenKind.EndOfFile) {
			printf("Error: Expected expression in builtin function call\n");
			exit(0);
		}

		let arg: *ASTNode = parse_expression(parser, 0);
		if arg as i32 == 0 {
			printf("Error: Expected expression in builtin function call\n");
			exit(0);
		}

		ast_add_child(node, arg);

		if lex_char_cmp(&parser.*.lex, ',') {
			parse_advance(parser);
		} else if !lex_char_cmp(&parser.*.lex, ')') {
			printf("Error: Expected ',' or ')' in builtin function call\n");
			exit(0);
		}
	}

	if !parse_expect_symbol(parser, ")") {
		printf("Error: Expected ')' to close builtin function call\n");
		exit(0);
	}

	node.*.span.end = parser.*.lex.pos;
	ast_set_builtin_call_data(parser.*.allocator, node, name_token.span);

	return node;
}

fun parse_type_node(parser: *Parser) : *ASTNode {
	let factor_type: Type = parse_type(parser);
	let type_node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Type, lex_init_span_source(parser.*.lex.pos, 0));
	type_node.*.data = alloc_new(parser.*.allocator, @sizeOf(Type)) as *u8;
	memcpy(type_node.*.data as *void, &factor_type, @sizeOf(Type));
	type_node.*.span.end = parser.*.lex.pos;
	return type_node;
}

fun parse_factor(parser: *Parser) : *ASTNode {
	let token: Token = lex_peek(&parser.*.lex, 0);

	let opr: Operator = parse_operator(parser, false);
	if opr != Operator.None && (opr == Operator.Not || opr == Operator.And) {
		let start_pos: i32 = parser.*.lex.pos;
		parse_operator(parser, true);

		let operand: *ASTNode = parse_factor(parser);
		if operand as i32 == 0 {
			return 0 as *ASTNode;
		}

		let unary_node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Unary, lex_init_span_source(start_pos, parser.*.lex.pos));
		ast_set_unary_op_data(unary_node, opr);
		ast_add_child(unary_node, operand);

		return unary_node;
	}

	if token.kind == TokenKind.Integer || token.kind == TokenKind.Float || token.kind == TokenKind.String || token.kind == TokenKind.Char || (token.kind == TokenKind.Keyword && (lex_string_cmp(&parser.*.lex, "true") || lex_string_cmp(&parser.*.lex, "false"))) {
		return parse_literal(parser);
	} else if token.kind == TokenKind.Keyword && lex_string_cmp(&parser.*.lex, "if") {
		return parse_if(parser);
	} else if lex_string_cmp(&parser.*.lex, "@") {
		return parse_builtin_call(parser);
	} else if token.kind == TokenKind.Symbol {
		if lex_string_cmp(&parser.*.lex, "(") {
			parse_advance(parser);

			let expr: *ASTNode = parse_expression(parser, 0);
			if expr as i32 == 0 {
				return 0 as *ASTNode;
			}

			if !parse_expect_symbol(parser, ")") {
				return 0 as *ASTNode;
			}

			return expr;
		} else if lex_string_cmp(&parser.*.lex, "[") {
			let saved_pos: i32 = parser.*.lex.pos;

			let temp_type: Type = parse_type(parser);

			if lex_char_cmp(&parser.*.lex, '{') {
				parser.*.lex.pos = saved_pos;
				return parse_composite(parser);
			} else {
				parser.*.lex.pos = saved_pos;
			}
		} else if lex_string_cmp(&parser.*.lex, ".") {
			return parse_anonymous(parser);
		}
	} else if token.kind == TokenKind.Identifier {
		let access_expr: *ASTNode = parse_access(parser);
		if access_expr as i32 == 0 {
			return 0 as *ASTNode;
		}

		if lex_char_cmp(&parser.*.lex, '(') {
			return parse_function_call(parser, access_expr);
		} else {
			return access_expr;
		}
	}

	return parse_type_node(parser);
}

fun parse_expression(parser: *Parser, limit: i32) : *ASTNode {
	let left: *ASTNode = parse_factor(parser);

	if left as i32 == 0 {
		return 0 as *ASTNode;
	}

	let opr: BinaryProirity = parse_binary_proirity(parser, false);

	while opr.operator != Operator.None && opr.priority > limit {
		parse_binary_proirity(parser, true);
		if opr.operator == Operator.Cast {
			let right: *ASTNode = parse_type_node(parser);

			let new_left: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Cast, lex_init_span_source(left.*.span.start, right.*.span.end));
			ast_add_child(new_left, left);
			ast_add_child(new_left, right);

			left = new_left;
		} else {
			let right: *ASTNode = parse_expression(parser, opr.priority + 1);

			if right as i32 == 0 {
				printf("Error: Expected right-hand side expression\n");
				return 0 as *ASTNode;
			}

			let new_left: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Binary, lex_init_span_source(left.*.span.start, right.*.span.end));
			ast_set_binary_op_data(new_left, opr.operator);
			ast_add_child(new_left, left);
			ast_add_child(new_left, right);
			left = new_left;
		}

		opr = parse_binary_proirity(parser, false);
	}
	
	return left;
}

// ============================================================================
// HYBRID PARSING
// ============================================================================

fun parse_statement(parser: *Parser) : *ASTNode;

fun parse_if(parser: *Parser) : *ASTNode {
	let start_pos: i32 = parser.*.lex.pos;

	if !parse_expect_keyword(parser, "if") {
		printf("Error: Expected 'if' keyword\n");
		return 0 as *ASTNode;
	}

	let condition: *ASTNode = parse_expression(parser, 0);
	if condition as i32 == 0 {
		printf("Error: Expected condition expression after 'if'\n");
		return 0 as *ASTNode;
	}

	let then_stmt: *ASTNode = parse_statement(parser);
	if then_stmt as i32 == 0 {
		printf("Error: Expected statement after if condition\n");
		return 0 as *ASTNode;
	}

	let has_else: bool = false;
	let else_stmt: *ASTNode = 0 as *ASTNode;

	if lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "else") {
		has_else = true;
		parse_advance(parser);

		if lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "if") {
			else_stmt = parse_if(parser);
		} else {
			else_stmt = parse_statement(parser);
		}

		if else_stmt as i32 == 0 {
			printf("Error: Expected statement after 'else'\n");
			return 0 as *ASTNode;
		}
	}

	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.If, lex_init_span_source(start_pos, parser.*.lex.pos));
	ast_set_if_data(parser.*.allocator, node, has_else);

	ast_add_child(node, condition);
	ast_add_child(node, then_stmt);
	if has_else {
		ast_add_child(node, else_stmt);
	}

	return node;
}

// ============================================================================
// STATEMENT PARSING
// ============================================================================

fun parse_while_statement(parser: *Parser) : *ASTNode {
	let start_pos: i32 = parser.*.lex.pos;

	if !parse_expect_keyword(parser, "while") {
		printf("Error: Expected 'while' keyword\n");
		return 0 as *ASTNode;
	}

	let condition: *ASTNode = parse_expression(parser, 0);

	if condition as i32 == 0 {
		printf("Error: Expected condition expression after 'while'\n");
		return 0 as *ASTNode;
	}

	let body: *ASTNode = parse_statement(parser);
	if body as i32 == 0 {
		printf("Error: Expected statement after while condition\n");
		return 0 as *ASTNode;
	}

	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.While, lex_init_span_source(start_pos, parser.*.lex.pos));
	node.*.data = 0 as *u8;

	ast_add_child(node, condition);
	ast_add_child(node, body);

	return node;
}

fun parse_assignment_statement(parser: *Parser) : *ASTNode {
	let start_pos: i32 = parser.*.lex.pos;

	let target: *ASTNode = parse_access(parser);
	if target as i32 == 0 {
		printf("Error: Expected variable or access expression for assignment\n");
		return 0 as *ASTNode;
	}

	let operator: Operator = parse_operator(parser, false);
	if operator != Operator.Assign {
		printf("Error: Expected '=' in assignment statement\n");
		return 0 as *ASTNode;
	}

	parse_operator(parser, true);

	let value: *ASTNode = parse_expression(parser, 0);
	if value as i32 == 0 {
		printf("Error: Expected expression after '=' in assignment\n");
		return 0 as *ASTNode;
	}

	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Assignment, lex_init_span_source(start_pos, parser.*.lex.pos));
	node.*.data = 0 as *u8;

	ast_add_child(node, target);
	ast_add_child(node, value);

	if lex_char_cmp(&parser.*.lex, ';') {
		parse_advance(parser);
	}

	return node;
}

fun parse_break_statement(parser: *Parser) : *ASTNode {
	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Break, lex_init_span_source(parser.*.lex.pos, 0));

	if !parse_expect_keyword(parser, "break") {
		printf("Error: Expected 'return' keyword\n");
		return 0 as *ASTNode;
	}

	let expr: *ASTNode = parse_expression(parser, 0);
	if expr as i32 != 0 {
		ast_add_child(node, expr);
	}

	node.*.span.end = parser.*.lex.pos;

	return node;
}

fun parse_continue_statement(parser: *Parser) : *ASTNode {
	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Continue, lex_init_span_source(parser.*.lex.pos, 0));

	if !parse_expect_keyword(parser, "continue") {
		printf("Error: Expected 'continue' keyword\n");
		return 0 as *ASTNode;
	}

	node.*.span.end = parser.*.lex.pos;

	return node;
}

fun parse_return_statement(parser: *Parser) : *ASTNode {
	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Return, lex_init_span_source(parser.*.lex.pos, 0));

	if !parse_expect_keyword(parser, "return") {
		printf("Error: Expected 'return' keyword\n");
		return 0 as *ASTNode;
	}

	let expr: *ASTNode = parse_expression(parser, 0);
	if expr as i32 == 0 {
		printf("Error: Expected expression after 'return'\n");
		return 0 as *ASTNode;
	}

	ast_add_child(node, expr);
	node.*.span.end = parser.*.lex.pos;

	return node;
}

fun parse_defer_statement(parser: *Parser) : *ASTNode {
	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Defer, lex_init_span_source(parser.*.lex.pos, 0));

	if !parse_expect_keyword(parser, "defer") {
		printf("Error: Expected 'defer' keyword\n");
		return 0 as *ASTNode;
	}

	let expr: *ASTNode = parse_expression(parser, 0);
	if expr as i32 == 0 {
		printf("Error: Expected expression after 'defer'\n");
		return 0 as *ASTNode;
	}

	ast_add_child(node, expr);
	node.*.span.end = parser.*.lex.pos;

	return node;
}

fun parse_block(parser: *Parser) : *ASTNode {
	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Block, lex_init_span_source(parser.*.lex.pos, 0));

	if !parse_expect_symbol(parser, "{") {
		printf("Error: Expected '{' at beginning of block\n");
		return 0 as *ASTNode;
	}

	while !lex_char_cmp(&parser.*.lex, '}') {
		if lex_kind_cmp(&parser.*.lex, TokenKind.EndOfFile) {
			break;
		}

		let stmt: *ASTNode = parse_statement(parser);
		if stmt as i32 != 0 {
			ast_add_child(node, stmt);
		} else {
			break;
		}
	}

	if !parse_expect_symbol(parser, "}") {
		printf("Error: Expected '}' at end of block\n");
		return 0 as *ASTNode;
	}

	node.*.span.end = parser.*.lex.pos;
	return node;
}

fun parse_variable_statement(parser: *Parser) : *ASTNode {
	let is_public: bool = false;
	let node_type: ASTNodeKind = ASTNodeKind.Let;

	if lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "pub") {
		is_public = true;
		parse_advance(parser);
	}

	if parse_expect_keyword(parser, "const") {
		node_type = ASTNodeKind.Const;
	} else {
		parse_advance(parser);
	}

	let node: *ASTNode = ast_create_node(parser.*.allocator, node_type, lex_init_span_source(parser.*.lex.pos, 0));

	let var_token: Token = lex_peek(&parser.*.lex, 0);
	if var_token.kind != TokenKind.Identifier {
		printf("Error: Expected variable name after 'let' or 'const'\n");
		return 0 as *ASTNode;
	}
	parse_advance(parser);

	ast_set_variable_data(parser.*.allocator, node, var_token.span, node_type == ASTNodeKind.Const, is_public);

	if parse_expect_symbol(parser, ":") {
		let type_node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Type, lex_init_span_source(parser.*.lex.pos, 0));
		let typ: Type = parse_type(parser);
		type_node.*.data = alloc_new(parser.*.allocator, @sizeOf(Type)) as *u8;
		memcpy(type_node.*.data as *void, &typ, @sizeOf(Type));
		type_node.*.span.end = parser.*.lex.pos;
		ast_add_child(node, type_node);
	}

	if !parse_expect_symbol(parser, "=") {
		printf("Error: Expected '=' in let statement\n");
		return 0 as *ASTNode;
	}

	let expr: *ASTNode = parse_expression(parser, 0);
	if expr as i32 == 0 {
		printf("Error: Expected expression after '=' in let statement\n");
		return 0 as *ASTNode;
	}

	ast_add_child(node, expr);
	node.*.span.end = parser.*.lex.pos;

	return node;
}

fun parse_statement(parser: *Parser) : *ASTNode {
	if lex_kind_cmp(&parser.*.lex, TokenKind.Identifier) {
		let saved_pos: i32 = parser.*.lex.pos;

		parse_access(parser);

		let operator: Operator = parse_operator(parser, false);
		let is_assignment: bool = operator == Operator.Assign;

		parser.*.lex.pos = saved_pos;

		if is_assignment {
			return parse_assignment_statement(parser);
		}
	}

	let stmt: *ASTNode = if lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "const") || lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "let") {
		parse_variable_statement(parser)
	} else if lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "break") {
		parse_break_statement(parser)
	} else if lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "continue") {
		parse_continue_statement(parser)
	} else if lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "return") {
		parse_return_statement(parser)
	} else if lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "defer") {
		parse_defer_statement(parser)
	} else if lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "if") {
		parse_if(parser)
	} else if lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "while") {
		parse_while_statement(parser)
	} else if lex_token_cmp(&parser.*.lex, TokenKind.Symbol, "{") {
		parse_block(parser)
	} else {
		parse_expression(parser, 0)
	};

	if stmt as i32 != 0 {
		if stmt.*.kind != ASTNodeKind.If && stmt.*.kind != ASTNodeKind.While && stmt.*.kind != ASTNodeKind.Block {
			parse_expect_symbol(parser, ";");

			// Check for semicolon for all statements except if, while, and block
			// if parse_expect_symbol(parser, ";") {
			// 	let current_token: Token = lex_peek(&parser.*.lex, 0);
			// 	lex_print_token(&parser.*.lex, &current_token);
			// 	printf("Error: Expected ';' after expression statement\n");
			// 	exit(0);
			// }
		}

		return stmt;
	}

	printf("Error: Failed to parse statement\n");
	return 0 as *ASTNode;
}

// ============================================================================
// FUNCTIONS PARSING
// ============================================================================

fun parse_param(parser: *Parser) : *FunctionParam {
	let param: *FunctionParam = alloc_new(parser.*.allocator, @sizeOf(FunctionParam)) as *FunctionParam;
	param.*.is_comptime = false;
	param.*.is_variadic = false;

	if lex_token_cmp(&parser.*.lex, TokenKind.Identifier, "params") {
		param.*.is_variadic = true;
		parse_advance(parser);
	}

	if lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "comptime") {
		param.*.is_comptime = true;
		parse_advance(parser);
	}

	let param_name_token: Token = lex_next(&parser.*.lex);
	if param_name_token.kind != TokenKind.Identifier {
		printf("Error: Expected parameter name identifier\n");
		exit(0);
	} else {
		param.*.name = param_name_token.span;
	}

	if !parse_expect_symbol(parser, ":") {
		printf("Error: Expected ':' after parameter name\n");
		exit(0);
	}

	param.*.param_type = parse_type(parser);

	return param;
}

fun parse_function(parser: *Parser) : *ASTNode {
	let is_public: bool = false;
	let is_external: bool = false;
	let is_declaration: bool = true;
	let parser_start_pos: i32 = parser.*.lex.pos;

	if lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "pub") {
		is_public = true;
		parse_advance(parser);
	}

	if lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "extern") {
		is_external = true;
		parse_advance(parser);
	}

	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Function, lex_init_span_source(parser_start_pos, 0));

	if !parse_expect_keyword(parser, "fun") {
		printf("Error: Expected 'fun' keyword\n");
		exit(0);
	}

	let name_token: Token = lex_next(&parser.*.lex);
	if name_token.kind != TokenKind.Identifier {
		printf("Error: Expected function name identifier\n");
		exit(0);
	}

	if !parse_expect_symbol(parser, "(") {
		printf("Error: Expected '('\n");
		exit(0);
	}

	let params: List = list_init(parser.*.allocator);

	while !lex_char_cmp(&parser.*.lex, ')') {
		let param: *FunctionParam = parse_param(parser);

		if param as i32 == 0 {
			printf("Error: Failed to parse parameter\n");
			exit(0);
		}

		list_push(&params, param as *void);

		parse_expect_symbol(parser, ",");
	}

	if !parse_expect_symbol(parser, ")") {
		printf("Error: Expected ')'\n");
		list_free(&params);
		return 0 as *ASTNode;
	}

	let return_type: Type = if parse_expect_symbol(parser, ":") {
		parse_type(parser)
	} else {
		let void_type: Type = .{};
		void_type.kind = TypeKind.Void;
		void_type.data = 0 as *u8;

		void_type
	}

	let node_body: *ASTNode = 0 as *ASTNode;
	if lex_char_cmp(&parser.*.lex, '{') {
		is_declaration = false;
		node_body = parse_block(parser);
	} else {
		is_declaration = true;
		parse_expect_symbol(parser, ";");
	}

	node.*.span.end = parser.*.lex.pos;

	ast_set_function_data(parser.*.allocator, node, name_token.span, return_type, params, node_body, is_public, is_external, is_declaration);

	return node;
}

// ============================================================================
// TOP-LEVEL PARSING
// ============================================================================

fun parse_member_declaration(parser: *Parser) : *ASTNode {
	let is_public: bool = false;
	let parser_start_pos: i32 = parser.*.lex.pos;

	if lex_token_cmp(&parser.*.lex, TokenKind.Keyword, "pub") {
		is_public = true;
		parse_advance(parser);
	}

	let member_name: Token = lex_next(&parser.*.lex);
	if member_name.kind != TokenKind.Identifier {
		printf("Error: Expected member name identifier\n");
		exit(0);
	}

	if !parse_expect_symbol(parser, ":") {
		printf("Error: Expected ':' after member name\n");
		exit(0);
	}

	let member_type: Type = parse_type(parser);

	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Member, lex_init_span_source(parser_start_pos, parser.*.lex.pos));
	ast_set_member_data(parser.*.allocator, node, member_name.span, is_public);

	let type_node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Type, lex_init_span_source(parser.*.lex.pos, 0));
	type_node.*.data = alloc_new(parser.*.allocator, @sizeOf(Type)) as *u8;
	memcpy(type_node.*.data as *void, &member_type, @sizeOf(Type));
	type_node.*.span.end = parser.*.lex.pos;
	ast_add_child(node, type_node);

	return node;
}

fun parse_enumerator_declaration(parser: *Parser) : *ASTNode {
	let parser_start_pos: i32 = parser.*.lex.pos;

	let enum_name_token: Token = lex_next(&parser.*.lex);
	if enum_name_token.kind != TokenKind.Identifier {
		let current_token: Token = lex_peek(&parser.*.lex, 0);
		lex_print_token(&parser.*.lex, &current_token);
		printf("Error: Expected enumerator name identifier\n");
		exit(0);
	}

	let node: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Enumerator, lex_init_span_source(parser_start_pos, parser.*.lex.pos));
	ast_set_enumerator_data(parser.*.allocator, node, enum_name_token.span);

	if parse_expect_symbol(parser, "=") {
		let value_expr: *ASTNode = parse_expression(parser, 0);
		if value_expr as i32 == 0 {
			printf("Error: Expected expression after '=' in enumerator\n");
			return 0 as *ASTNode;
		}
		ast_add_child(node, value_expr);
	}

	return node;
}

fun parse_declaration(parser: *Parser) : *ASTNode {
	let position: i32 = 0;

	while true {
		let token: Token = lex_peek(&parser.*.lex, position);
		let token_str: *u8 = lex_span_source(&parser.*.lex, token.span, false);
		defer free(token_str);

		if token.kind == TokenKind.Keyword && strcmp(token_str, "pub") == 0 {
			position = position + 1;
			continue;
		}

		if token.kind == TokenKind.Keyword && strcmp(token_str, "extern") == 0 {
			position = position + 1;
			continue;
		}

		if token.kind == TokenKind.Keyword && strcmp(token_str, "fun") == 0 {
			return parse_function(parser);
		}

		if token.kind == TokenKind.Keyword && (strcmp(token_str, "let") == 0 || strcmp(token_str, "const") == 0) {
			return parse_variable_statement(parser);
		}

		if token.kind == TokenKind.Identifier {
			let next_token: Token = lex_peek(&parser.*.lex, position + 1);
			let next_str: *u8 = lex_span_source(&parser.*.lex, next_token.span, false);
			defer free(next_str);

			if next_token.kind == TokenKind.Symbol && strcmp(next_str, ":") == 0 {
				return parse_member_declaration(parser);
			}
			else if next_token.kind == TokenKind.Symbol && (strcmp(next_str, ",") == 0 || strcmp(next_str, "=") == 0) {
				return parse_enumerator_declaration(parser);
			}

		}

		if token.kind == TokenKind.EndOfFile {
			break;
		}

		position = position + 1;
	}

	return 0 as *ASTNode;
}

fun parse_aggregate(parser: *Parser, kind: ASTNodeKind) : *ASTNode {
	let root: *ASTNode = ast_create_node(parser.*.allocator, kind, lex_init_span_source(parser.*.lex.pos, 0));

	parse_advance(parser);

	if !parse_expect_symbol(parser, "{") {
		printf("Error: Expected '{' after 'struct' keyword\n");
		return 0 as *ASTNode;
	}

	while !lex_eof(&parser.*.lex) && !lex_char_cmp(&parser.*.lex, '}') {
		let decl: *ASTNode = parse_declaration(parser);

		if decl as i32 != 0 {
			ast_add_child(root, decl);

			if lex_char_cmp(&parser.*.lex, ';') {
				parse_advance(parser);
			} else if lex_char_cmp(&parser.*.lex, ',') {
				parse_advance(parser);
			}
		} else {
			parse_advance(&parser);
		}

		let token: Token = lex_peek(&parser.*.lex, 0);
		if token.kind == TokenKind.EndOfFile {
			break;
		}
	}

	if !parse_expect_symbol(parser, "}") {
		printf("Error: Expected '}' after 'struct' keyword\n");
		return 0 as *ASTNode;
	}

	root.*.span.end = parser.*.lex.pos;

	return root;
}

fun parse_program(parser: *Parser) : *ASTNode {
	let root: *ASTNode = ast_create_node(parser.*.allocator, ASTNodeKind.Struct, lex_init_span_source(0, 0));

	while !lex_eof(&parser.*.lex) {
		let decl: *ASTNode = parse_declaration(parser);

		if decl as i32 != 0 {
			ast_add_child(root, decl);

			if lex_char_cmp(&parser.*.lex, ';') {
				parse_advance(parser);
			} else if lex_char_cmp(&parser.*.lex, ',') {
				parse_advance(parser);
			}
		} else {
			parse_advance(&parser);
		}
		
		let token: Token = lex_peek(&parser.*.lex, 0);
		if token.kind == TokenKind.EndOfFile {
			break;
		}
	}

	return root;
}

// ============================================================================
// MAIN
// ============================================================================

fun main(argc: i32, argv: **u8) : i32 {
	let allocator: Allocator = alloc_init();
	let filename: *u8 = "examples/main.line";

	if argc > 1 {
		filename = argv[1];
	}

	let src: *u8 = read_file_all(filename);
	defer free(src);

	let parser: Parser = parser_init(lex_init(src), &allocator);
	let ast: *ASTNode = parse_program(&parser);

	ast_print_node(&parser.lex, ast, 0);

	alloc_debug(&allocator);
	alloc_free(&allocator);

	return 0;
}
