// ============================================================================
// STANDARD EXTERN
// ============================================================================

// Standard I/O functions
pub extern fun printf(format: *u8, param values: [any]);
pub extern fun scanf(format: *u8, param values: [any]);
pub extern fun fopen(path: *u8, mode: *u8) : *void;
pub extern fun fclose(file: *void);
pub extern fun fread(ptr: *void, size: u32, count: u32, file: *void) : u32;
pub extern fun fseek(file: *void, offset: i32, origin: i32) : i32;
pub extern fun ftell(file: *void) : i32;

// Memory management functions
pub extern fun malloc(size: u32) : *void;
pub extern fun calloc(count: u32, size: u32) : *void;
pub extern fun realloc(ptr: *void, size: u32) : *void;
pub extern fun free(ptr: *void);

// Memory functions
pub extern fun memcpy(dest: *void, src: *void, n: u32) : *void;
pub extern fun memmove(dest: *void, src: *void, n: u32) : *void;
pub extern fun memset(ptr: *void, value: i32, n: u32) : *void;
pub extern fun memcmp(ptr1: *void, ptr2: *void, n: u32) : i32;

// String functions
pub extern fun strlen(str: *u8) : u32;
pub extern fun strcpy(dest: *u8, src: *u8) : *u8;
pub extern fun strcmp(str1: *u8, str2: *u8) : i32;
pub extern fun strcat(dest: *u8, src: *u8) : *u8;
pub extern fun strncpy(dest: *u8, src: *u8, n: u32) : *u8;

// System functions
pub extern fun exit(status: i32) : void;
pub extern fun getenv(name: *u8) : *u8;
pub extern fun system(command: *u8) : i32;

// ============================================================================
// GENERIC DYNAMIC LIST (VECTOR)
// ============================================================================

const List = struct {
	data: *u8,
	len: u32,
	cap: u32,
	elem_size: u32
}

fun list_init(elem_size: u32) : List {
	let arr: List = .{};
	arr.data = malloc(elem_size * 8) as *u8;
	arr.len = 0;
	arr.cap = 8;
	arr.elem_size = elem_size;
	return arr;
}

fun list_push(arr: *List, value: *void) {
	if (arr.*.len >= arr.*.cap) {
		arr.*.cap = arr.*.cap * 2;
		arr.*.data = realloc(arr.*.data, arr.*.cap * arr.*.elem_size) as *u8;
	}

	let dest: *u8 = arr.*.data + arr.*.len * arr.*.elem_size;
	memcpy(dest as *void, value, arr.*.elem_size);
	arr.*.len = arr.*.len + 1;
}

fun list_get(arr: *List, index: u32) : *void {
	if index >= arr.*.len {
		return 0 as *void;
	} else if index < 0 {
		return 0 as *void;
	}

	return (arr.*.data + index * arr.*.elem_size) as *void;
}

fun list_set(arr: *List, index: u32, value: *void) {
	if index >= arr.*.len {
		return;
	} else if index < 0 {
		return;
	}

	let dest: *u8 = arr.*.data + index * arr.*.elem_size;
	memcpy(dest as *void, value, arr.*.elem_size);
}

fun list_pop(arr: *List) : *void {
	if arr.*.len == 0 {
		return 0 as *void;
	}

	arr.*.len = arr.*.len - 1;
	let value: *void = arr.*.data + arr.*.len * arr.*.elem_size;
	return value;
}

fun list_size(arr: *List) : u32 {
	return arr.*.len;
}

fun list_free(arr: *List) {
	free(arr.*.data);
	arr.*.data = 0;
	arr.*.len = 0;
	arr.*.cap = 0;
	arr.*.elem_size = 0;
}

// ============================================================================
// IO
// ============================================================================

fun read_file_all(path: *u8) : *u8 {
	let file: *void = fopen(path, "rb");
	if (file as i32 == 0) {
		printf("Failed to open file: %s\n", path);
		exit(1);
	}

	fseek(file, 0, 2);
	let size: i32 = ftell(file);
	fseek(file, 0, 0);

	let buf: *u8 = malloc(size + 1) as *u8;
	if (buf as i32 == 0) {
		printf("Failed to allocate memory for file\n");
		fclose(file);
		exit(1);
	}

	let read_size: i32 = fread(buf, 1, size, file);
	buf[read_size] = 0;
	fclose(file);
	return buf;
}

// ============================================================================
// LEXER
// ============================================================================

const SpanSource = struct {
	start: i32,
	end: i32,
}

const Location = struct {
	idx: i32,
	line: i32,
}

const TokenKind = enum {
	Identifier,
	Integer,
	Float,
	String,
	Char,
	Symbol,
	Keyword,
	EndOfFile,
}

const Token = struct {
	kind: TokenKind,
	span: SpanSource,
	loc: Location,
}

const LexState = struct {
	src: *u8,
	src_len: i32,
	pos: i32,
	loc: Location,
}

fun is_letter(c: u8) : bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

fun is_digit(c: u8) : bool {
	return (c >= '0' && c <= '9');
}

fun is_keyword(str: *u8) : bool {
	if strcmp(str, "pub") == 0 { return true; }
	else if strcmp(str, "left") == 0 { return true; }
	else if strcmp(str, "fun") == 0 { return true; }
	else if strcmp(str, "return") == 0 { return true; }
	else if strcmp(str, "if") == 0 { return true; }
	else if strcmp(str, "else") == 0 { return true; }
	else if strcmp(str, "match") == 0 { return true; }
	else if strcmp(str, "for") == 0 { return true; }
	else if strcmp(str, "while") == 0 { return true; }
	else if strcmp(str, "in") == 0 { return true; }
	else if strcmp(str, "defer") == 0 { return true; }
	else if strcmp(str, "continue") == 0 { return true; }
	else if strcmp(str, "break") == 0 { return true; }
	else if strcmp(str, "void") == 0 { return true; }
	else if strcmp(str, "bool") == 0 { return true; }
	else if strcmp(str, "comp") == 0 { return true; }
	else if strcmp(str, "extern") == 0 { return true; }
	else if strcmp(str, "struct") == 0 { return true; }
	else if strcmp(str, "enum") == 0 { return true; }
	else if strcmp(str, "union") == 0 { return true; }
	else if strcmp(str, "true") == 0 { return true; }
	else if strcmp(str, "false") == 0 { return true; }
	else if strcmp(str, "any") == 0 { return true; }
	else if strcmp(str, "as") == 0 { return true; }
	else { return false; }
}

fun lex_init(src: *u8) : LexState {
	let state: LexState = .{};
	state.src = src;
	state.src_len = strlen(src) as i32;
	state.pos = 0;
	state.loc = .{ .index = 0, .line = 1};
	return state;
}

fun lex_init_span_source(start: i32, end: i32) : SpanSource {
	let s: SpanSource = .{};
	s.start = start;
	s.end = end;
	return s;
}

fun lex_eof(state: *LexState) : bool {
	return state.*.pos >= state.*.src_len;
}

fun lex_init_token(state: *LexState, kind: TokenKind, start: i32, end: i32) : Token {
	let t: Token = .{};
	t.kind = kind;
	t.span = lex_init_span_source(start, end);
	t.loc = state.*.loc;
	return t;
}

fun lex_span_source(state: *LexState, src: SpanSource, handle_escapes: bool) : *u8 {
	let len: i32 = src.end - src.start;
	let text: *u8 = malloc(len + 1) as *u8;

	if handle_escapes {
		let read_pos: i32 = 0;
		let write_pos: i32 = 0;

		while read_pos < len {
			let c: u8 = state.*.src[src.start + read_pos];

			if c == '\\' && (read_pos + 1) < len {
				read_pos = read_pos + 1;
				let escape_char: u8 = state.*.src[src.start + read_pos];

				if escape_char == 'n' {
					text[write_pos] = '\n';
				} else if escape_char == 't' {
					text[write_pos] = '\t';
				} else if escape_char == 'r' {
					text[write_pos] = '\r';
				} else if escape_char == '\\' {
					text[write_pos] = '\\';
				} else if escape_char == '\'' {
					text[write_pos] = '\'';
				} else if escape_char == '"' {
					text[write_pos] = '"';
				} else if escape_char == '0' {
					text[write_pos] = '\0';
				} else {
					text[write_pos] = escape_char;
				}
			} else {
				text[write_pos] = c;
			}

			read_pos = read_pos + 1;
			write_pos = write_pos + 1;
		}

		text[write_pos] = 0; // null-terminate
	} else {
		strncpy(text, state.*.src + src.start, len as u32);
		text[len] = 0; // null-terminate
	}

	return text;
}

fun lex_char(state: *LexState) : u8 {
	if lex_eof(state) {
		return '\0';
	}

	return state.*.src[state.*.pos];
}

fun lex_skip_whitespace(src: *u8, i: *i32) {
	while (src[i.*] == ' ' || src[i.*] == '\t' || src[i.*] == '\n' || src[i.*] == '\r') {
		let index: i32 = i.*;

		index = index + 1;
		i.* = index;
	}
}

fun lex_next_char(state: *LexState) : u8 {
	if lex_eof(state) {
		return '\0';
	}

	let c: u8 = state.*.src[state.*.pos];
	state.*.pos = state.*.pos + 1;

	return c;
}

fun lex_peek_char(state: *LexState, index: i32) : u8 {
	if lex_eof(state) {
		return '\0';
	}

	if (state.*.pos + index) >= state.*.src_len {
		return '\0';
	}

	return state.*.src[state.*.pos + index];
}

fun lex_number(state: *LexState) : Token {
	let start_pos: i32 = state.*.pos;
	let is_float: bool = false;

	while !lex_eof(state) && is_digit(lex_char(state)) || (lex_char(state) == '.' && !is_float) {
		if lex_char(state) == '.' {
			is_float = true;

			if lex_peek_char(state, 1) == '.' {
				break;
			}
		}

		state.*.pos = state.*.pos + 1;
	}

	let token: Token = lex_init_token(state, if is_float { TokenKind.Float } else { TokenKind.Integer }, start_pos, state.*.pos);
	return token;
}

fun lex_string(state: *LexState) : Token {
	lex_next_char(state);
	let start_pos: i32 = state.*.pos;

	while !lex_eof(state) {
		let c: u8 = lex_char(state);
		
		if c == '"' {
			break;
		} else if c == '\\' {
			state.*.pos = state.*.pos + 1;

			if !lex_eof(state) {
				state.*.pos = state.*.pos + 1;
			}
		} else {
			state.*.pos = state.*.pos + 1;
		}
	}

	let end_pos: i32 = state.*.pos;
	lex_next_char(state);

	return lex_init_token(state, TokenKind.String, start_pos, end_pos);
}

fun lex_character(state: *LexState) : Token {
	lex_next_char(state);
	let start_pos: i32 = state.*.pos;

	if !lex_eof(state) {
		let c: u8 = lex_char(state);
		
		if c == '\\' {
			state.*.pos = state.*.pos + 1;

			if !lex_eof(state) {
				state.*.pos = state.*.pos + 1;
			}
		} else {
			state.*.pos = state.*.pos + 1;
		}
	}

	let end_pos: i32 = state.*.pos;
	lex_next_char(state);

	return lex_init_token(state, TokenKind.Char, start_pos, end_pos);
}

fun lex_identifier(state: *LexState) : Token {
	let start_pos: i32 = state.*.pos;

	while !lex_eof(state) && is_letter(lex_char(state)) {
		state.*.pos = state.*.pos + 1;
	}

	return lex_init_token(state, TokenKind.Identifier, start_pos, state.*.pos);
}

fun lex_symbol(state: *LexState) : Token {
	let start_pos: i32 = state.*.pos;
	state.*.pos = state.*.pos + 1;

	return lex_init_token(state, TokenKind.Symbol, start_pos, state.*.pos);
}

fun lex_next(state: *LexState) : Token {
	if lex_eof(state) {
		return lex_init_token(state, TokenKind.EndOfFile, 0, 0);
	}

	while !lex_eof(state) {
		let c: u8 = lex_char(state);

		if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
			lex_next_char(state);
			continue;
		}

		if c == '"' {
			return lex_string(state);
		}

		if c == '\'' {
			return lex_character(state);
		}

		if is_letter(c) {
			return lex_identifier(state);
		}

		if is_digit(c) {
			return lex_number(state);
		}

		return lex_symbol(state);
	}

	return lex_init_token(state, TokenKind.EndOfFile, 0, 0);
}

fun lex_peek(state: *LexState, index: i32) : Token {
	let token: Token = .{};

	let saved_pos: i32 = state.*.pos;

	while index >= 0 {
		token = lex_next(state);
		index = index - 1;
	}

	state.*.pos = saved_pos;

	return token;
}

// ============================================================================
// MAIN
// ============================================================================

fun main() : i32 {
	let src: *u8 = read_file_all("examples/hello-world.line");
	defer free(src);

	let lex: LexState = lex_init(src);

	while !lex_eof(&lex) {
		let token: Token = lex_next(&lex);
		let token_src: *u8 = lex_span_source(&lex, token.span, false);
		defer free(token_src);

		printf("Token: '%s' '%s'\n", @enumStr(TokenKind, token.kind), token_src);
		if token.kind == TokenKind.EndOfFile {
			break;
		}
	}

	return 0;
}
